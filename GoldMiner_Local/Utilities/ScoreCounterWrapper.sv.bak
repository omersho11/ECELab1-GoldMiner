module ScoreCounterWrapper (
    input  logic clk,
    input  logic resetN,
    input  logic [19:0] increase, 
    input  logic [19:0] decrease,
    output logic [19:0] value
);
    import GlobalsPKG::*; 

    Counter #(
        .WIDTH($bits(SCORE)) 
    ) counter_inst (
        .clk(clk),
        .resetN(resetN),
        .increase(increase),
        .decrease(decrease),
        .value(value)
    );
endmodule